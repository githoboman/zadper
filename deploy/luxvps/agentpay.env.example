# Service environment for AgentPay.  Copy to
# /home/agentops/agentpay/runtime/agentpay.env, replace every <...> value,
# and keep it readable only by the deployment account.  Never commit the
# filled file.

AGENTPAY_PUBLIC_ORIGIN=https://agentpay.timidan.xyz
AGENTPAY_ALLOWED_ORIGINS=https://agentpay.timidan.xyz
AGENTPAY_SESSION_COOKIE_PATH=/api/v1
AGENT_PAY_RESOURCE_BASE_URL=https://agentpay.timidan.xyz/api
AGENTPAY_ALLOW_LOOPBACK_PROBES=0

MCP_ALLOWED_ORIGINS=https://agentpay.timidan.xyz
MCP_SERVER_AUTH_TOKEN=<generate-a-random-64-hex-token>
MCP_PUBLIC_TESTNET_ASSESSMENTS=1
MCP_ALLOW_UNAUTHENTICATED_PRIVILEGED_TOOLS=0
AGENT_PAY_ALLOW_REPORT_API_URL_OVERRIDE=0

CASPER_NETWORK=casper-testnet
CASPER_CHAIN_NAME=casper-test
CASPER_RPC_URL=https://node.testnet.casper.network/rpc
CASPER_NODE_ADDRESS=https://node.testnet.casper.network/rpc
AGENTPAY_DEFAULT_EVIDENCE_NETWORK=casper-mainnet
AGENTPAY_MAINNET_RPC_URL=https://node.mainnet.casper.network/rpc
AGENTPAY_TESTNET_RPC_URL=https://node.testnet.casper.network/rpc
CSPR_TRADE_MCP_URL=https://mcp.cspr.trade/mcp
CSPR_NAME_API_BASE_URL=https://api.cspr.name
CSPR_LIVE_MAINNET_API_URL=https://api.mainnet.cspr.live
CSPR_LIVE_TESTNET_API_URL=https://api.testnet.cspr.live

X402_NETWORK=casper:casper-test
X402_ASSET_PACKAGE_HASH=<64-hex-Casper-Testnet-package-hash>
X402_TOKEN_NAME=<on-chain-token-name>
X402_TOKEN_VERSION=<authorization-domain-version>
X402_TOKEN_DECIMALS=<on-chain-decimals>
X402_TOKEN_SYMBOL=<on-chain-symbol>
PAYEE_ADDRESS=<00-plus-64-hex-recipient>
AGENT_PAY_REPORT_AMOUNT=<price-in-token-base-units>
AGENT_PAY_EXPECTED_PAYEE_ADDRESS=<same-as-PAYEE_ADDRESS>
AGENT_PAY_EXPECTED_X402_ASSET=<same-as-X402_ASSET_PACKAGE_HASH>
AGENT_PAY_EXPECTED_NETWORK=casper:casper-test
AGENT_PAY_MAX_REPORT_AMOUNT=<maximum-base-units-per-public-check>

# The Compose file overrides this to the loopback facilitator namespace.
# Leave the hosted value here only when deliberately using the external
# CSPR.cloud facilitator instead of the supplied private binary.
X402_FACILITATOR_URL=https://x402-facilitator.cspr.cloud
X402_FACILITATOR_AUTH_TOKEN=<project-token-or-empty>

AGENT_PAY_API_TOKEN=<optional-api-token>
AGENT_PAY_REGISTRY_PACKAGE_HASH=<64-hex-registry-package-hash>
AGENT_PAY_REGISTRY_CONTRACT_HASH=<64-hex-registry-contract-hash>
AGENT_PAY_REGISTRY_RECORDER_ACCOUNT_HASH=<00-plus-64-hex-account-hash>
AGENT_PAY_REGISTRY_RECORDER_KEY_PATH=/run/agentpay/keys/registry-recorder-secret.pem
AGENT_PAY_REPO_ROOT=/app
AGENT_PAY_RECORD_SCRIPT=contracts/agent-pay-registry/scripts/record-decision-testnet.sh
AGENT_PAY_RECEIPT_RECORD_SCRIPT=contracts/agent-pay-registry/scripts/record-receipt-testnet.sh
CASPER_CLIENT_COMMAND=/usr/local/bin/casper-client

# The application containers use this buyer key.  The facilitator container
# overrides it with /run/agentpay/keys/facilitator-secret.pem.
CASPER_SECRET_KEY_PATH=/run/agentpay/keys/buyer-secret.pem
