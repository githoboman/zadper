# Host-side Compose interpolation.  This file contains paths and image
# metadata only; keep the service secrets in AGENTPAY_SERVICE_ENV_FILE.
AGENTPAY_COMPOSE_PROJECT=agentpay
AGENTPAY_IMAGE=agentpay:d1f9997
AGENTPAY_WEB_IMAGE=agentpay-web:d1f9997
AGENTPAY_REVISION=d1f99977b78a473b826b70023ca103c07261f982
AGENTPAY_NODE_VERSION=22.23.1
AGENTPAY_PNPM_VERSION=11.3.0
AGENTPAY_RUNTIME_UID=10001
AGENTPAY_RUNTIME_GID=10001

# Use /home/agentops/agentpay/runtime/agentpay.env on the host after copying and filling
# agentpay.env.example.  Do not place credentials in this file.
AGENTPAY_SERVICE_ENV_FILE=/home/agentops/agentpay/runtime/agentpay.env
AGENTPAY_STATE_DIR=/home/agentops/agentpay/runtime/state
AGENTPAY_KEY_DIR=/home/agentops/agentpay/runtime/keys
CASPER_CLIENT_BINARY=/home/agentops/agentpay/runtime/bin/casper-client
X402_FACILITATOR_BINARY=/home/agentops/agentpay/runtime/bin/x402-facilitator
X402_FACILITATOR_SHA256=446af929ec3f32b85cf3f33205c1eeaaf445e956689687bd7cec94b5059aa52b

# The Caddy-connected external network must already exist.  The internal
# network is created by Compose and is never reachable from the host.
CADDY_NETWORK=public_proxy
AGENTPAY_INTERNAL_NETWORK=agentpay_internal
AGENTPAY_EGRESS_NETWORK=agentpay_egress
